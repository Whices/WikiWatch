
.lien-carte {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 190px;
    padding: 24px 22px;

    color: var(--text-main);
    text-decoration: none;
    background: var(--card-bg);

    clip-path: polygon(
        0 0,
        calc(100% - var(--coupe)) 0,
        100% var(--coupe),
        100% 100%,
        0 100%
    );

    transform: perspective(800px)
        rotateX(var(--rx, 0deg))
        rotateY(var(--ry, 0deg))
        translateY(var(--ty, 0px));

    transition: transform 0.15s ease-out;
}

/* Bordure extérieure */
.lien-carte::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--accent, var(--orange));

    clip-path: polygon(
        0 0,
        calc(100% - var(--coupe)) 0,
        100% var(--coupe),
        100% 100%,
        0 100%
    );

    opacity: 0;
    transition: opacity 0.2s ease;
}

/* Intérieur de la carte */
.lien-carte::after {
    content: "";
    position: absolute;
    inset: 1px;
    background: var(--card-bg);

    /* Barre inférieure */
    box-shadow: inset 0 -4px var(--accent, var(--orange));

    clip-path: polygon(
        0 0,
        calc(100% - var(--coupe) - 3px) 0,
        100% calc(var(--coupe) + 3px),
        100% 100%,
        0 100%
    );

    opacity: 0;
    transition: opacity 0.2s ease, background 0.2s ease;
}

/* Survol */
.lien-carte:hover {
    --ty: -5px;
}

.lien-carte:hover::before,
.lien-carte:hover::after {
    opacity: 1;
}

.lien-carte:hover::after {
    background: #212631;
}

/* Contenu au-dessus des pseudo-éléments */
.lien-carte > * {
    position: relative;
    z-index: 1;
}
